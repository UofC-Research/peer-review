# Local environment variables for peer-review.
#
# Copy this file to `.env` for local runs:
#
#   cp .env.example .env
#
# Keep `.env` private. It is ignored by git because it can contain credentials.

# Storage connection settings.
#
# Required by `configs/prod.yml` because it expands `${POSTGRES_URL}` for the
# PostgreSQL storage backend. `configs/local.yml` uses DuckDB and does not
# require credential values, but it still loads the repo-root `.env` file.
POSTGRES_URL=postgresql+psycopg2://user:password@host:5432/database

# AWS credentials for optional bioRxiv/medRxiv requester-pays TDM S3 sync.
#
# Used by:
# - peer_elt.acquire.tdm.AwsCliTdmArchiveClient
# - AWS CLI commands such as:
#     aws s3 sync s3://biorxiv-src-monthly data/raw/tdm/biorxiv --region us-east-1 --request-payer requester
#     aws s3 sync s3://medrxiv-src-monthly data/raw/tdm/medrxiv --region us-east-1 --request-payer requester
#
# The code accepts either these uppercase AWS CLI variable names or lowercase
# aliases such as `aws_access_key_id` and `aws_secret_access_key`.
AWS_ACCESS_KEY_ID=replace-with-your-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-your-secret-access-key

# Include this only when using temporary AWS credentials.
# AWS_SESSION_TOKEN=replace-with-your-session-token

# Optional. The bioRxiv/medRxiv TDM buckets are documented in us-east-1.
AWS_DEFAULT_REGION=us-east-1

# Optional. Use instead of explicit access keys if your local AWS CLI profile is
# already configured and allowed to access requester-pays buckets.
# AWS_PROFILE=replace-with-your-profile-name

# Live integration test config.
#
# These tests are opt-in. Copy `configs/live_tests.example.yml` to
# `configs/live_tests.local.yml`, set `enabled: true`, then either pass
# `--live-config configs/live_tests.local.yml` to pytest or set this variable.
# PEER_REVIEW_LIVE_CONFIG=configs/live_tests.local.yml
